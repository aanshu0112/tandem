ANTHROPIC_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
GOOGLE_MAPS_API_KEY=
# only if Google says "streetviewerror/signature"
GOOGLE_MAPS_SIGNING_SECRET=

# ---- optional (empty = off) ----
# The iMessage number judges text. Shown on the dashboard's idle screen with a QR code, e.g. +16075551234
TANDEM_PHONE=
# Public https address for trip links in iMessage. Leave empty when using `bun run tunnel`, which sets it automatically
PUBLIC_URL=
# Rehearse the icy-hill scene on a dry day: "icy" fakes freezing rain (labeled "(demo)" in the texts)
TANDEM_WEATHER=
# "fake" uses fixtures/demo-scout.json instead of real scouts (also the default with no Google key)
SCOUT_MODE=
# Use one Overpass (OpenStreetMap) server instead of trying the public ones in turn
OVERPASS_URL=

# ---- optional overrides: uncomment to change. An empty value here would NOT mean "default" ----
# SCOUT_MODEL=claude-sonnet-5-5
# SCOUT_MIN_CONFIDENCE=0.5
# SCOUT_VISION_CONCURRENCY=8
# DASHBOARD_PORT=3000
# TANDEM_DB=data/tandem.sqlite
